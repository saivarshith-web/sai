#include <stdio.h>
#include <stdlib.h>
 
int main()
{
int n, i, head, totalSeek = 0;
printf("Enter number of requests: ");
scanf("%d", &n);
 
int req[n];
 
printf("Enter request queue:\n");
for(i = 0; i < n; i++)
scanf("%d", &req[i]);
 
printf("Enter initial head position: ");
scanf("%d", &head);
 
printf("\nHead Movement: %d", head);
 
for(i = 0; i < n; i++)
{
totalSeek += abs(head - req[i]);
head = req[i];
printf(" -> %d", head);
}
 
printf("\nTotal Seek Time = %d", totalSeek);
printf("\nAverage Seek Time = %.2f\n",
(float)totalSeek / n);
 
return 0;
}
