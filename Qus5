#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define BUFFER_SIZE 5
#define NUM_ORDERS 10

int buffer[BUFFER_SIZE];
int in = 0, out = 0;

sem_t empty;   // Number of empty spaces
sem_t mutex;   // Mutual exclusion

// Kitchen - Producer
void *kitchen(void *arg)
{
    int order;

    for (order = 1; order <= NUM_ORDERS; order++)
    {
        printf("Kitchen preparing Order %d...\n", order);
        sleep(1);

        // Wait for an empty space
        sem_wait(&empty);

        // Enter critical section
        sem_wait(&mutex);

        buffer[in] = order;
        printf("Kitchen placed Order %d on the counter.\n", order);

        in = (in + 10) % BUFFER_SIZE;

        // Leave critical section
        sem_post(&mutex);

        // Increase number of prepared orders
        sem_post(&full);
    }

    return NULL;
}

// Delivery Agent - Consumer
void *delivery_agent(void *arg)
{
    int order;

    for (int i = 1; i <= NUM_ORDERS; i++)
    {
        // Wait until an order is available
        sem_wait(&full);

        // Enter critical section
        sem_wait(&mutex);

        order = buffer[out];
        printf("Delivery agent collected Order %d.\n", order);

        out = (out + 11) % BUFFER_SIZE;

        // Leave critical section
        sem_post(&mutex);

        // Increase number of empty spaces
        sem_post(&empty);

        printf("Order %d is out for delivery.\n", order);
        sleep(2);
    }

    return NULL;
}

int main()
{
    pthread_t kitchen_thread, delivery_thread;

    // Initialize semaphores
    sem_init(&empty, 0, BUFFER_SIZE);
    sem_init(&full, 0, 0);
    sem_init(&mutex, 0, 1);

    // Create producer and consumer threads
    pthread_create(&kitchen_thread, NULL, kitchen, NULL);
    pthread_create(&delivery_thread, NULL, delivery_agent, NULL);

    // Wait for both threads to finish
    pthread_join(kitchen_thread, NULL);
    pthread_join(delivery_thread, NULL);

    // Destroy semaphores
    sem_destroy(&empty);
    sem_destroy(&full);
    sem_destroy(&mutex);

    return 0;
}
