#include <stdio.h>

#define INF 9999

int main()
{
    int n, i, j;
    int cost[20][20], visited[20] = {0};
    int edges = 0, min, u = 0, v = 0, total = 0;

    printf("Enter number of buildings: ");
    scanf("%d", &n);

    printf("Enter the cost adjacency matrix:\n");
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);

            if (cost[i][j] == 0)
                cost[i][j] = INF;
        }
    }

    visited[0] = 1;

    printf("\nEdges in Minimum Spanning Tree:\n");

    while (edges < n - 1)
    {
        min = INF;

        for (i = 0; i < n; i++)
        {
            if (visited[i])
            {
                for (j = 0; j < n; j++)
                {
                    if (!visited[j] && cost[i][j] < min)
                    {
                        min = cost[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        printf("Building %d - Building %d : Cost = %d\n",
               u + 1, v + 1, min);

        total += min;
        visited[v] = 1;
        edges++;
    }

    printf("\nMinimum total cable installation cost = %d\n", total);

    return 0;
}
