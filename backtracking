#include <stdio.h>

int n;
int distance[10][10];
int visited[10];
int path[10];
int bestPath[11];
int minimumCost = 999999;

void TSP(int current, int count, int cost)
{
    int i;

    if (count == n)
    {
        cost = cost + distance[current][0];

        if (cost < minimumCost)
        {
            minimumCost = cost;

            for (i = 0; i < n; i++)
            {
                bestPath[i] = path[i];
            }

            bestPath[n] = 0;
        }
        return;
    }

    for (i = 0; i < n; i++)
    {
        if (visited[i] == 0)
        {
            visited[i] = 1;
            path[count] = i;

            TSP(i, count + 1, cost + distance[current][i]);

            visited[i] = 0;
        }
    }
}

int main()
{
    int i, j;

    printf("Enter number of hospitals: ");
    scanf("%d", &n);

    printf("Enter the distance matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &distance[i][j]);
        }
    }

    for (i = 0; i < n; i++)
    {
        visited[i] = 0;
    }

    visited[0] = 1;
    path[0] = 0;

    TSP(0, 1, 0);

    printf("\nMinimum Travel Distance: %d", minimumCost);

    printf("\nShortest Route: ");

    for (i = 0; i <= n; i++)
    {
        printf("%d", bestPath[i] + 1);

        if (i < n)
        {
            printf(" -> ");
        }
    }

    return 0;
}
